local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
    Name = "Escape The Lava",
    LoadingTitle = "",
    LoadingSubtitle = "By sondubai",
    ConfigurationSaving = {
        Enabled = false,
    }
})

local MainTab = Window:CreateTab("Farm", 4483362458)

local function TeleportToPortal(portal)
    local player = game:GetService("Players").LocalPlayer
    local character = player.Character or player.CharacterAdded:Wait()
    local hrp = character:WaitForChild("HumanoidRootPart")
    hrp.CFrame = portal.CFrame + Vector3.new(0, 5, 0)
end

local tpSpace = false
local tpRainbow = false
local tpVolcano = false
local tpFrozen = false

MainTab:CreateToggle({
    Name = "TP Space",
    CurrentValue = false,
    Callback = function(Value)
        tpSpace = Value
        task.spawn(function()
            while tpSpace do
                TeleportToPortal(workspace.DynamicObjects.Worlds.Space.WinPortal.Touch)
                task.wait(2)
            end
        end)
    end,
})

