        autoRepair = Value
    end,
})

local function tpTo(part)
    if hrp and part then
        pcall(function() hrp.CFrame = part.CFrame end)
    end
end

-- repairMachine kept simple; escape handled by separate loop
local function repairMachine(part)
    if part and part:IsA("BasePart") and RepairEvent then
        tpTo(part)
        for i = 1, 30 do
            if not autoRepair then return end
            -- don't repair while in escape cooldown
            if tick() - lastEscape < escapeCooldown then
                task.wait(0.2)
            else
                pcall(function() RepairEvent:FireServer(part, true) end)
                task.wait(0.2)
            end
        end
    end
end

task.spawn(function()
    while task.wait(1) do
        if autoRepair and RepairEvent then
            local generatorsFolder = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Generator")
            if generatorsFolder then
                for _, machine in ipairs(generatorsFolder:GetChildren()) do
                    if not autoRepair then break end
                    repairMachine(machine)
                end
            end
        end
    end
end)


local function findSafeCenter()

    local map = workspace:FindFirstChild("Map")
    if map then
        local safe = map:FindFirstChild("SafeZone") or map:FindFirstChild("Safe")
        if safe then
            if safe:IsA("Model") then
                if safe.PrimaryPart then return safe.PrimaryPart.CFrame end
                for _, v in ipairs(safe:GetDescendants()) do
                    if v:IsA("BasePart") then return v.CFrame end
                end
            elseif safe:IsA("BasePart") then
                return safe.CFrame
            end
        end
    end
    local spawn = workspace:FindFirstChild("SpawnLocation") or workspace:FindFirstChild("Spawn")
    if spawn and spawn:IsA("BasePart") then return spawn.CFrame end
    if hrp then return hrp.CFrame end
    return CFrame.new(0,1000,0)
end

local function startEscape()
    if isEscaping then return end
    isEscaping = true
    lastEscape = tick()

    local centerCFrame = findSafeCenter()
    -- prefer above current position if safe zone too far
    local centerPos = (hrp and hrp.Position) or centerCFrame.Position
    local basePos = Vector3.new(centerPos.X, centerPos.Y + escapeHeight, centerPos.Z)

    -- teleport lên trước
    pcall(function() hrp.CFrame = CFrame.new(basePos) end)

    local startTime = tick()
    local angle = 0
    local angularSpeed = (math.pi * 2) / escapeDuration -- full circle trong escapeDuration
    local center = basePos

    while tick() - startTime < escapeDuration do
        local t = tick() - startTime
        angle = angularSpeed * t
        local x = center.X + math.cos(angle) * escapeRadius
        local z = center.Z + math.sin(angle) * escapeRadius
        local y = center.Y
        -- set CFrame facing center (thoát an toàn)
        local lookAt = CFrame.new(Vector3.new(x, y, z), center)
        pcall(function() hrp.CFrame = lookAt end)
        task.wait(0.03)
    end

    pcall(function() hrp.CFrame = CFrame.new(center) end)
    lastEscape = tick()
    task.delay(escapeCooldown, function()
        isEscaping = false
    end)
end

local function characterHasWeapon(ch)
    if not ch then return false end
    if ch:FindFirstChild("Weapon") then return true end
    if ch:FindFirstChildWhichIsA("Tool") then return true end
    if ch:FindFirstChild("Weapon", true) then return true end
    return false
end

task.spawn(function()
    while task.wait(0.4) do
        if not autoRepair then continue end
        if not hrp then continue end
        if isEscaping then continue end
        if tick() - lastEscape < escapeCooldown then continue end

        for _, pl in ipairs(Players:GetPlayers()) do
            if pl ~= player and pl.Character and pl.Character.Parent then
                if characterHasWeapon(pl.Character) then
                    local target = pl.Character:FindFirstChild("HumanoidRootPart") or pl.Character:FindFirstChildWhichIsA("BasePart")
                    if target then
                        local dist = (hrp.Position - target.Position).Magnitude
                        if dist <= escapeDistance then
                            -- bắt đầu escape (teleport lên & vòng)
                            startEscape()
                            break
                        end
                    end
                end
            end
        end
    end
end)

local noclipEnabled = false
local savedCollision = {}

local function saveAndSetCollide(v)
    if not char then return end
    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") and not part.Anchored then
            if v == false then
                if savedCollision[part] == nil then savedCollision[part] = part.CanCollide end
                part.CanCollide = false
            else
                if savedCollision[part] ~= nil then
                    pcall(function() part.CanCollide = savedCollision[part] end)
                    savedCollision[part] = nil
                else
                    pcall(function() part.CanCollide = true end)
                end
            end
        end
    end
end

