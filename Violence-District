local autoRepair = false
local RepairEvent
if ReplicatedStorage:FindFirstChild("Remotes") 
   and ReplicatedStorage.Remotes:FindFirstChild("Generator") 
   and ReplicatedStorage.Remotes.Generator:FindFirstChild("RepairEvent") then
    RepairEvent = ReplicatedStorage.Remotes.Generator.RepairEvent
end

MainTab:CreateToggle({
    Name = "Auto Generators",
    CurrentValue = false,
    Flag = "AutoRepair",
    Callback = function(Value)
        autoRepair = Value
    end,
})

local function tpTo(part)
    if hrp and part then
        hrp.CFrame = part.CFrame
    end
end

local function repairMachine(part)
    if part and part:IsA("BasePart") then
        tpTo(part)
        for i = 1, 30 do
            if not autoRepair then return end
            RepairEvent:FireServer(part, true)
            task.wait(0.2)
        end
    end
end

task.spawn(function()
    while task.wait(1) do
        if autoRepair and RepairEvent then
            local generatorsFolder = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Generator")
            if generatorsFolder then
                for _, machine in ipairs(generatorsFolder:GetChildren()) do
                    if not autoRepair then break end
                    repairMachine(machine)
                end
            end
        end
    end
end)

local noclipEnabled = false
local function setCanCollide(value)
    if char then
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") and not part.Anchored then
                part.CanCollide = value
            end
        end
    end
end

MainTab:CreateToggle({
    Name = "Noclip",
    CurrentValue = false,
    Flag = "Noclip",
    Callback = function(val)
        noclipEnabled = val
        if not noclipEnabled then
            setCanCollide(true)
        end
    end,
})

RunService.Stepped:Connect(function()
    if noclipEnabled then
        setCanCollide(false)
    end
end)

player.CharacterAdded:Connect(function(newChar)
    char = newChar
    hrp = char:WaitForChild("HumanoidRootPart")
    if not noclipEnabled then
        setCanCollide(true)
    end
end)

