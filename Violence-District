local function createText() local t=Drawing.new("Text") t.Size=18 t.Center=true t.Outline=true t.OutlineColor=Color3.new(0,0,0) t.Color=Color3.fromRGB(255,0,0) t.Visible=false t.Font=2 return t end
local function ensureESP(p) if espTexts[p] then return end espTexts[p]=createText() end
local function removeESP(p) if espTexts[p] then pcall(function() espTexts[p]:Remove() end) espTexts[p]=nil end end
for _,p in ipairs(Players:GetPlayers()) do if p~=player then if p.Character then ensureESP(p) end p.CharacterAdded:Connect(function() ensureESP(p) end) end end
Players.PlayerAdded:Connect(function(p) if p~=player then p.CharacterAdded:Connect(function() ensureESP(p) end) end end)
Players.PlayerRemoving:Connect(removeESP)
local function characterHasWeapon(ch)
    if not ch then return false end
    if ch:FindFirstChild("Weapon") then return true end
    if ch:FindFirstChildWhichIsA("Tool") then return true end
    if ch:FindFirstChild("Weapon",true) then return true end
    return false
end
RunService.RenderStepped:Connect(function()
    if not espEnabled then return end
    if not hrp or not hrp.Parent then hrp=player.Character and player.Character:FindFirstChild("HumanoidRootPart") if not hrp then return end end
    for plr,txt in pairs(espTexts) do
        if not plr or plr==player then pcall(function() txt.Visible=false end) else
            local c=plr.Character
            local target=c and (c:FindFirstChild("HumanoidRootPart") or c:FindFirstChildWhichIsA("BasePart"))
            local ok=c and characterHasWeapon(c)
            if target and ok then
                local pos2d,onScreen=camera:WorldToViewportPoint(target.Position+Vector3.new(0,-2,0))
                if onScreen then
                    local dist=(hrp.Position-target.Position).Magnitude
                    txt.Text=plr.Name.." ("..(dist>=1000 and string.format("%.2f km",dist/1000) or string.format("%.0f m",dist))..")"
                    txt.Position=Vector2.new(pos2d.X,pos2d.Y)
                    txt.Visible=true
                else txt.Visible=false end
            else txt.Visible=false end
        end
    end
end)
local flySpeed = 100
local flying = false
local flycontrol = {F = 0, B = 0, R = 0, L = 0, U = 0, D = 0}
local bv, bg
local humanoid
local function startFly()
    if flying then return end
    if not char or not hrp then return end
    humanoid = char:FindFirstChildWhichIsA("Humanoid")
    if not humanoid then return end
    flying = true
    bv = Instance.new("BodyVelocity")
    bg = Instance.new("BodyGyro")
    bv.MaxForce = Vector3.new(9e4, 9e4, 9e4)
    bg.MaxTorque = Vector3.new(9e4, 9e4, 9e4)
    bg.P = 9e4
    bv.Velocity = Vector3.zero
    bg.CFrame = hrp.CFrame
    bv.Parent = hrp
    bg.Parent = hrp
    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            task.spawn(function()
                local con
                con = RunService.Stepped:Connect(function()
                    if not flying then con:Disconnect() part.CanCollide = true return end
                    part.CanCollide = false
                end)
            end)
        end
    end
    task.spawn(function()
        while flying and bv and bg do
            humanoid.PlatformStand = true
            local cam = workspace.CurrentCamera
            local look = cam.CFrame.LookVector
            local right = cam.CFrame.RightVector
            local up = cam.CFrame.UpVector
            local moveDir = (look * (flycontrol.F - flycontrol.B) + right * (flycontrol.R - flycontrol.L) + up * (flycontrol.U - flycontrol.D)) * flySpeed
            bv.Velocity = moveDir
            bg.CFrame = cam.CFrame
            task.wait()
        end
        if bv then bv:Destroy() end
        if bg then bg:Destroy() end
        if humanoid then humanoid.PlatformStand = false end
    end)
end
local function stopFly() flying = false end
uis.InputBegan:Connect(function(input, gp)
    if gp then return end
    local key = input.KeyCode
    if key == Enum.KeyCode.W then flycontrol.F = 1 end
    if key == Enum.KeyCode.S then flycontrol.B = 1 end
    if key == Enum.KeyCode.D then flycontrol.R = 1 end
    if key == Enum.KeyCode.A then flycontrol.L = 1 end
    if key == Enum.KeyCode.Space then flycontrol.U = 1 end
    if key == Enum.KeyCode.Q then flycontrol.D = 1 end
end)
uis.InputEnded:Connect(function(input)
    local key = input.KeyCode
    if key == Enum.KeyCode.W then flycontrol.F = 0 end
    if key == Enum.KeyCode.S then flycontrol.B = 0 end
    if key == Enum.KeyCode.D then flycontrol.R = 0 end
    if key == Enum.KeyCode.A then flycontrol.L = 0 end
    if key == Enum.KeyCode.Space then flycontrol.U = 0 end
    if key == Enum.KeyCode.Q then flycontrol.D = 0 end
end)
MiscTab:CreateToggle({Name = "Fly", CurrentValue = false, Flag = "FlyToggle", Callback = function(v) if v then startFly() else stopFly() end end})
MiscTab:CreateSlider({Name = "Fly Speed", Range = {10, 500}, Increment = 10, Suffix = "Speed", CurrentValue = flySpeed, Flag = "FlySpeed", Callback = function(v) flySpeed = v end})
