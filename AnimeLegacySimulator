local LOADER = 'loadstring(game:HttpGet("https://raw.githubusercontent.com/canhongson/CanHongSon/refs/heads/main/Main"))()'
local GUI_NAME = "LoaderNotice"
local IDLE_TEXT = "Copy script"

local THEME = {
	panel = Color3.fromRGB(21, 28, 43),
	field = Color3.fromRGB(9, 13, 22),
	accent = Color3.fromRGB(255, 138, 61),
	onAccent = Color3.fromRGB(26, 14, 4),
	text = Color3.fromRGB(215, 227, 255),
	muted = Color3.fromRGB(154, 165, 186),
}

local function create(class, props, children)
	local instance = Instance.new(class)
	for key, value in pairs(props) do
		instance[key] = value
	end
	for _, child in ipairs(children or {}) do
		child.Parent = instance
	end
	return instance
end

local function corner(radius)
	return create("UICorner", { CornerRadius = UDim.new(0, radius) })
end

local function label(props)
	props.BackgroundTransparency = 1
	props.TextWrapped = true
	props.TextXAlignment = Enum.TextXAlignment.Left
	props.TextYAlignment = Enum.TextYAlignment.Top
	return create("TextLabel", props)
end

local function copyToClipboard(text)
	local write = setclipboard or toclipboard
	if write then
		write(text)
		return true
	end
	return false
end

local host = (gethui and gethui()) or game:GetService("CoreGui")
local previous = host:FindFirstChild(GUI_NAME)
if previous then
	previous:Destroy()
end

local field = create("TextBox", {
	Size = UDim2.new(1, -32, 0, 76),
	Position = UDim2.fromOffset(16, 98),
	BackgroundColor3 = THEME.field,
	BorderSizePixel = 0,
	ClearTextOnFocus = false,
	TextEditable = false,
	TextWrapped = true,
	TextXAlignment = Enum.TextXAlignment.Left,
	TextYAlignment = Enum.TextYAlignment.Top,
	Font = Enum.Font.Code,
	TextSize = 13,
	TextColor3 = THEME.text,
	Text = LOADER,
}, { corner(6) })

local copyButton = create("TextButton", {
	Size = UDim2.fromOffset(150, 40),
	Position = UDim2.fromOffset(16, 192),
	BackgroundColor3 = THEME.accent,
	BorderSizePixel = 0,
	Font = Enum.Font.GothamBold,
	TextSize = 15,
	TextColor3 = THEME.onAccent,
	Text = IDLE_TEXT,
}, { corner(8) })

local closeButton = create("TextButton", {
	Size = UDim2.fromOffset(32, 32),
	Position = UDim2.new(1, -44, 0, 14),
	BackgroundTransparency = 1,
	Font = Enum.Font.GothamBold,
	TextSize = 18,
	TextColor3 = THEME.muted,
	Text = "X",
})

local panel = create("Frame", {
	Size = UDim2.fromOffset(440, 250),
	Position = UDim2.new(0.5, -220, 0.5, -125),
	BackgroundColor3 = THEME.panel,
	BorderSizePixel = 0,
	Active = true,
	Draggable = true,
}, {
	corner(10),
	label({
		Size = UDim2.new(1, -60, 0, 36),
		Position = UDim2.fromOffset(16, 12),
		Font = Enum.Font.GothamBold,
		TextSize = 20,
		TextColor3 = THEME.accent,
		Text = "Loader has changed",
	}),
	label({
		Size = UDim2.new(1, -32, 0, 40),
		Position = UDim2.fromOffset(16, 50),
		Font = Enum.Font.Gotham,
		TextSize = 14,
		TextColor3 = THEME.muted,
		Text = "The old loader is no longer updated. Copy the new script below and run it in your executor.",
	}),
	field,
	copyButton,
	closeButton,
})

local gui = create("ScreenGui", { Name = GUI_NAME, ResetOnSpawn = false }, { panel })
gui.Parent = host

copyButton.MouseButton1Click:Connect(function()
	if copyToClipboard(LOADER) then
		copyButton.Text = "Copied"
	else
		field.TextEditable = true
		field:CaptureFocus()
		copyButton.Text = "Select and copy"
	end

	task.delay(1.5, function()
		if copyButton.Parent then
			copyButton.Text = IDLE_TEXT
		end
	end)
end)

closeButton.MouseButton1Click:Connect(function()
	gui:Destroy()
end)
