local function AddBigTitle(Tab, Text)
    local Container = Tab:AddSection(" ")
    if Container and Container.Container then
        local BigLabel = Instance.new("TextLabel")
        BigLabel.Name = "BigTitle"
        BigLabel.Size = UDim2.new(1, 0, 0, 14)
        BigLabel.BackgroundTransparency = 1
        BigLabel.Text = Text
        BigLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        BigLabel.TextSize = 24
        BigLabel.Font = Enum.Font.GothamBold
        BigLabel.TextXAlignment = Enum.TextXAlignment.Left
        BigLabel.TextYAlignment = Enum.TextYAlignment.Center
        BigLabel.Parent = Container.Container
    else
        Tab:AddParagraph({ Title = ">>> " .. Text .. " <<<", Content = "" })
    end
end

