local LockConn
local function LockOnMob(mob)
    if LockConn then LockConn:Disconnect() end
    LockConn = RunService.Heartbeat:Connect(function()
        if not Runtime.AutoFarm or not mob or not mob.Parent or not mob:FindFirstChild("Humanoid") or mob.Humanoid.Health <= 0 then
            if LockConn then LockConn:Disconnect() LockConn = nil end
            return
        end
        local pos = mob.HumanoidRootPart.Position + Vector3.new(0, Runtime.SafeY or 10, 0)
        HRP().CFrame = CFrame.lookAt(pos, mob.HumanoidRootPart.Position)
        HRP().AssemblyLinearVelocity = Vector3.zero
        HRP().AssemblyAngularVelocity = Vector3.zero
    end)
end

local function LockOnFirstMobWithSafeY(firstMob)
    if LockConn then LockConn:Disconnect() end
    LockConn = RunService.Heartbeat:Connect(function()
        if not Runtime.AutoFarm or not Runtime.BringMob or not firstMob or not firstMob.Parent or not firstMob:FindFirstChild("Humanoid") or firstMob.Humanoid.Health <= 0 then
            if LockConn then LockConn:Disconnect() LockConn = nil end
            return
        end
        local mobPos = firstMob.HumanoidRootPart.Position
        local pos = mobPos + Vector3.new(0, Runtime.SafeY or 10, 0)
        HRP().CFrame = CFrame.lookAt(pos, mobPos)
        HRP().AssemblyLinearVelocity = Vector3.zero
        HRP().AssemblyAngularVelocity = Vector3.zero
    end)
end

