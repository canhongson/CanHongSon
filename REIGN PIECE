table.sort(TeleportList)
if #TeleportList == 0 then TeleportList = {"No NPCs Found"} end

local TeleportNPCDropdown = Tabs.Teleport:AddDropdown("TeleportNPC", {
    Title = "Select NPC",
    Values = TeleportList,
    AllowNull = true
}):OnChanged(function(v) Runtime.SelectedTeleportNPC = v end)

Tabs.Teleport:AddButton({
    Title = "Teleport to NPC",
    Callback = function()
        if not Runtime.SelectedTeleportNPC or Runtime.SelectedTeleportNPC == "No NPCs Found" then
            Fluent:Notify({ Title = "Error", Content = "Please select an NPC first", Duration = 3 })
            return
        end
        local targetNPC = nil
        for _, path in ipairs(PathsToCheck) do
            if path then
                local found = path:FindFirstChild(Runtime.SelectedTeleportNPC)
                if found then targetNPC = found break end
            end
        end
        if targetNPC and targetNPC:FindFirstChild("HumanoidRootPart") then
            HRP().CFrame = targetNPC.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
            Fluent:Notify({ Title = "Teleport", Content = "Teleported to " .. Runtime.SelectedTeleportNPC, Duration = 2 })
        else
            Fluent:Notify({ Title = "Error", Content = "NPC not found or invalid", Duration = 3 })
        end
    end
})

AddBigTitle(Tabs.Teleport, "Teleport To Island")
local IslandPath = workspace:FindFirstChild("Ignore") and workspace.Ignore:FindFirstChild("Locations")
local IslandList = {}
if IslandPath then
    for _, island in ipairs(IslandPath:GetChildren()) do
        if island:IsA("Model") or island:IsA("Folder") then table.insert(IslandList, island.Name) end
    end
end
if #IslandList == 0 then IslandList = {"No Islands Found"} end

local IslandDropdown = Tabs.Teleport:AddDropdown("SelectIsland", {
    Title = "Select Island",
    Values = IslandList,
    AllowNull = true
}):OnChanged(function(v) Runtime.SelectedTeleportIsland = v end)

Tabs.Teleport:AddButton({
    Title = "Teleport to Island",
    Callback = function()
        if not Runtime.SelectedTeleportIsland or Runtime.SelectedTeleportIsland == "No Islands Found" then
            Fluent:Notify({ Title = "Error", Content = "Please select an island first", Duration = 3 })
            return
        end
        local targetIsland = IslandPath:FindFirstChild(Runtime.SelectedTeleportIsland)
        local targetPosition = nil
        if targetIsland then
            local primaryPart = targetIsland:FindFirstChildWhichIsA("BasePart", true)
            if primaryPart then targetPosition = primaryPart.Position else targetPosition = targetIsland:GetPivot().Position end
        end
        if targetPosition then
            HRP().CFrame = CFrame.new(targetPosition + Vector3.new(0, 50, 0))
            Fluent:Notify({ Title = "Teleport", Content = "Teleported to " .. Runtime.SelectedTeleportIsland, Duration = 2 })
        else
            Fluent:Notify({ Title = "Error", Content = "Island location not found", Duration = 3 })
        end
    end
})

