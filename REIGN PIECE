local WeaponDropdown = nil
local LastWeaponCount = 0
local DropdownCurrentValue = nil

local function GetWeaponList()
    local weapons = {}
    local char = LP.Character
    local backpack = LP.Backpack

    if backpack then
        for _,v in ipairs(backpack:GetChildren()) do
            if v:IsA("Tool") then
                table.insert(weapons, v.Name)
            end
        end
    end

    if char then
        for _,v in ipairs(char:GetChildren()) do
            if v:IsA("Tool") then
                local found = false
                for _, wName in pairs(weapons) do
                    if wName == v.Name then
                        found = true
                        break
                    end
                end
                if not found then
                    table.insert(weapons, v.Name)
                end
            end
        end
    end
    return weapons
end

local function WatchWeaponDropdown()
    task.spawn(function()
