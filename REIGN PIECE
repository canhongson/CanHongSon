local function BringAllMobsToFirstMob()
    if not Runtime.AutoFarm or not Runtime.BringMob then return end
    local questMobName = GetQuestMobName()
    if not questMobName then return end
    local firstMob = GetFirstQuestMob()
    if not firstMob then return end
    local targetPos = firstMob.HumanoidRootPart.Position
    for _,mob in ipairs(EnemyFolder:GetChildren()) do
        if mob.Name == questMobName and mob:FindFirstChild("HumanoidRootPart") and mob:FindFirstChild("Humanoid") and mob.Humanoid.Health > 0 then
            local mobHRP = mob.HumanoidRootPart
            mobHRP.CFrame = CFrame.new(targetPos)
            mobHRP.AssemblyLinearVelocity = Vector3.zero
            mobHRP.AssemblyAngularVelocity = Vector3.zero
        end
    end
end

