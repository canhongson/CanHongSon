                    Runtime.Weapon = currentVal
                end
            end
        end
    end)
end

local function StartAutoWeaponCheck()
    task.spawn(function()
        while task.wait(0.5) do
            if not WeaponDropdown then continue end

            local currentList = GetWeaponList()
            local currentCount = #currentList

            if currentCount ~= LastWeaponCount then
                LastWeaponCount = currentCount
                
                if #currentList == 0 then currentList = {"No Weapons"} end
                
                WeaponDropdown:SetValues(currentList)
                
                if WeaponDropdown.Value == nil then
                    Runtime.Weapon = nil
                    DropdownCurrentValue = nil
                end
            end
        end
    end)
end

