----------------------------------------------------------------- helpers
local function New(class, props, kids)
    local o = Instance.new(class)
    for k, v in pairs(props or {}) do
        if k ~= "Parent" then o[k] = v end
    end
    for _, c in ipairs(kids or {}) do c.Parent = o end
    if props and props.Parent then o.Parent = props.Parent end
    return o
end

local function Corner(r) return New("UICorner", { CornerRadius = UDim.new(0, r or 6) }) end
local function Stroke(c, t)
    return New("UIStroke", { Color = c or Theme.Stroke, Thickness = t or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end
local function Pad(n) return New("UIPadding", { PaddingTop = UDim.new(0, n), PaddingBottom = UDim.new(0, n), PaddingLeft = UDim.new(0, n), PaddingRight = UDim.new(0, n) }) end
local function List(p) return New("UIListLayout", { Padding = UDim.new(0, p or 6), SortOrder = Enum.SortOrder.LayoutOrder }) end
local function Tween(o, props, t) TweenService:Create(o, TweenInfo.new(t or 0.15, Enum.EasingStyle.Quad), props):Play() end

local function Label(props)
    props.BackgroundTransparency = 1
    props.Font = props.Font or Enum.Font.Gotham
    props.TextColor3 = props.TextColor3 or Theme.Text
    props.TextSize = props.TextSize or 14
    props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
    return New("TextLabel", props)
end

local order = 0
local function Ord() order += 1 return order end

local function GetParent()
    local ok, p = pcall(function() return (gethui and gethui()) or game:GetService("CoreGui") end)
    if ok and p then return p end
    return Players.LocalPlayer:WaitForChild("PlayerGui")
end

local function IsPress(i)
    return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch
end
local function IsMove(i)
    return i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch
end

local Conns = {}
local function C(sig, fn)
    local c = sig:Connect(fn)
    table.insert(Conns, c)
    return c
end

-- kéo thả cửa sổ
local function Drag(handle, target)
    local dragging, start, orig
    handle.InputBegan:Connect(function(i)
        if IsPress(i) then
            dragging, start, orig = true, i.Position, target.Position
            i.Changed:Connect(function()
                if i.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    C(UIS.InputChanged, function(i)
        if dragging and IsMove(i) then
            local d = i.Position - start
            target.Position = UDim2.new(orig.X.Scale, orig.X.Offset + d.X, orig.Y.Scale, orig.Y.Offset + d.Y)
        end
    end)
end

-- theo dõi chuột trong 1 frame (slider, color picker); trả về hàm ngắt kết nối
local function Track(frame, cb)
    local on = false
    local function upd(i)
        local rx = math.clamp((i.Position.X - frame.AbsolutePosition.X) / frame.AbsoluteSize.X, 0, 1)
        local ry = math.clamp((i.Position.Y - frame.AbsolutePosition.Y) / frame.AbsoluteSize.Y, 0, 1)
        cb(rx, ry)
    end
    frame.InputBegan:Connect(function(i) if IsPress(i) then on = true upd(i) end end)
    local a = UIS.InputEnded:Connect(function(i) if IsPress(i) then on = false end end)
    local b = UIS.InputChanged:Connect(function(i) if on and IsMove(i) then upd(i) end end)
    return function() a:Disconnect() b:Disconnect() end
end

----------------------------------------------------------------- AutoSave
local Save = { Data = {}, Path = nil, On = true, Pending = false }
local hasFS = type(writefile) == "function" and type(readfile) == "function"
    and type(isfile) == "function" and type(makefolder) == "function" and type(isfolder) == "function"

function Save.Init(folder, name)
    if not hasFS then return end
    pcall(function() if not isfolder(folder) then makefolder(folder) end end)
    Save.Path = folder .. "/" .. name .. ".json"
    pcall(function()
        if isfile(Save.Path) then Save.Data = HttpService:JSONDecode(readfile(Save.Path)) end
    end)
end

function Save.Queue()
    if not Save.On or not Save.Path or Save.Pending then return end
    Save.Pending = true
    task.delay(0.5, function()
        Save.Pending = false
        pcall(function() writefile(Save.Path, HttpService:JSONEncode(Save.Data)) end)
    end)
end

-- gắn callback + autosave + autoload cho mỗi element
local function Finish(obj, index, cfg, ser, load)
    obj._cb = {}
    function obj:OnChanged(f) table.insert(self._cb, f) end
    function obj:_fire()
        for _, f in ipairs(self._cb) do task.spawn(f, self.Value) end
        Save.Data[index] = ser(self)
        Save.Queue()
    end
    if cfg and cfg.Callback then table.insert(obj._cb, cfg.Callback) end
    Scarlet.Options[index] = obj
    local d = Save.Data[index]
    if d ~= nil then pcall(load, obj, d) end
end

----------------------------------------------------------------- Notify
local NotifyHolder
function Scarlet:Notify(cfg)
    if not NotifyHolder then
        local g = New("ScreenGui", { Name = "ScarletNotify", ResetOnSpawn = false, IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Sibling })
        g.Parent = GetParent()
        NotifyHolder = New("Frame", {
            Parent = g, BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 1),
            Position = UDim2.new(1, -16, 1, -16), Size = UDim2.new(0, 270, 1, -32),
        }, { New("UIListLayout", { Padding = UDim.new(0, 8), VerticalAlignment = Enum.VerticalAlignment.Bottom, SortOrder = Enum.SortOrder.LayoutOrder }) })
    end
    local scale = New("UIScale", { Scale = 0.8 })
    local n = New("Frame", {
        Parent = NotifyHolder, BackgroundColor3 = Theme.Row, Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = Ord(),
    }, { Corner(8), Stroke(Theme.Accent), Pad(10), List(2), scale })
    Label({ Parent = n, Text = cfg.Title or "Notification", Font = Enum.Font.GothamBold, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextWrapped = true, LayoutOrder = 1 })
    if cfg.Content then
        Label({ Parent = n, Text = cfg.Content, TextSize = 13, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextWrapped = true, LayoutOrder = 2 })
    end
    if cfg.SubContent then
        Label({ Parent = n, Text = cfg.SubContent, TextSize = 12, TextColor3 = Theme.Sub, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextWrapped = true, LayoutOrder = 3 })
    end
    Tween(scale, { Scale = 1 }, 0.2)
    local obj = {}
    function obj:Close()
        if n.Parent then
            Tween(scale, { Scale = 0.8 }, 0.15)
            task.delay(0.15, function() n:Destroy() end)
        end
    end
    if cfg.Duration then task.delay(cfg.Duration, function() obj:Close() end) end
    return obj
end

----------------------------------------------------------------- Popup (dropdown / colorpicker)
local function OpenPopup(gui, anchor, w, h)
    local catcher = New("TextButton", { Parent = gui, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 100 })
    local pos, sz, vp = anchor.AbsolutePosition, anchor.AbsoluteSize, gui.AbsoluteSize
    local y = pos.Y + sz.Y + 4
    if y + h > vp.Y then y = pos.Y - h - 4 end
    local x = math.clamp(pos.X + sz.X - w, 4, math.max(4, vp.X - w - 4))
    local box = New("Frame", {
        Parent = catcher, Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h),
        BackgroundColor3 = Theme.Row2, Active = true,
    }, { Corner(6), Stroke() })
    catcher.MouseButton1Click:Connect(function() catcher:Destroy() end)
    return box, catcher
end

local function KeyMatch(i, key)
    if key == "MB1" then return i.UserInputType == Enum.UserInputType.MouseButton1 end
    if key == "MB2" then return i.UserInputType == Enum.UserInputType.MouseButton2 end
    if key == "MB3" then return i.UserInputType == Enum.UserInputType.MouseButton3 end
    return i.UserInputType == Enum.UserInputType.Keyboard and i.KeyCode.Name == key
end

local function Round(n, r) local m = 10 ^ (r or 0) return math.floor(n * m + 0.5) / m end

----------------------------------------------------------------- Window
function Scarlet:CreateWindow(cfg)
    cfg = cfg or {}
    Save.On = cfg.AutoSave ~= false
    if Save.On then
        local name = (tostring(cfg.Title or "Window"):gsub("[^%w]", "_")) .. "_" .. tostring(game.GameId)
        Save.Init(cfg.SaveFolder or "Scarlet", name)
    end

    local TabWidth = cfg.TabWidth or 150
    local Window = {}
    local tabs = {}

    local Gui = New("ScreenGui", { Name = "Scarlet", ResetOnSpawn = false, IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Sibling })
    Gui.Parent = GetParent()

    local Main = New("Frame", {
        Parent = Gui, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Size = cfg.Size or UDim2.fromOffset(580, 460), BackgroundColor3 = Theme.Bg, ClipsDescendants = true,
    }, { Corner(10), Stroke() })

    local Top = New("Frame", { Parent = Main, Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = Theme.Side, BorderSizePixel = 0 })
    Label({ Parent = Top, Text = cfg.Title or "Scarlet", Font = Enum.Font.GothamBold, TextSize = 15, Position = UDim2.fromOffset(14, 0), Size = UDim2.new(0, 200, 1, 0), AutomaticSize = Enum.AutomaticSize.X })
    local sub = Label({ Parent = Top, Text = cfg.SubTitle or "", TextSize = 12, TextColor3 = Theme.Sub, Size = UDim2.new(0, 200, 1, 0) })
    -- đặt subtitle ngay sau title
    task.defer(function()
        local t = Top:FindFirstChildOfClass("TextLabel")
        sub.Position = UDim2.fromOffset(14 + t.AbsoluteSize.X + 8, 0)
    end)
    Drag(Top, Main)

    local Fab = New("TextButton", {
        Parent = Gui, Visible = false, Size = UDim2.fromOffset(40, 40), Position = UDim2.fromOffset(12, 12),
        BackgroundColor3 = Theme.Accent, Text = "S", Font = Enum.Font.GothamBold, TextSize = 18, TextColor3 = Color3.new(1, 1, 1), AutoButtonColor = true,
    }, { Corner(20) })
    local function setVisible(v) Main.Visible = v Fab.Visible = not v end
    Fab.MouseButton1Click:Connect(function() setVisible(true) end)

    local function TopBtn(text, x, cb)
        local b = New("TextButton", {
            Parent = Top, Text = text, Font = Enum.Font.GothamBold, TextSize = 16, TextColor3 = Theme.Sub,
            BackgroundTransparency = 1, Size = UDim2.fromOffset(32, 32), Position = UDim2.new(1, x, 0, 4),
        })
        b.MouseButton1Click:Connect(cb)
        return b
    end
    TopBtn("×", -38, function() Window:Destroy() end)
    TopBtn("–", -72, function() setVisible(false) end)

    local Side = New("Frame", { Parent = Main, Position = UDim2.fromOffset(0, 40), Size = UDim2.new(0, TabWidth, 1, -40), BackgroundColor3 = Theme.Side, BorderSizePixel = 0 })
    local TabList = New("ScrollingFrame", {
        Parent = Side, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0,
        ScrollBarThickness = 0, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
    }, { List(4), Pad(8) })
    local Content = New("Frame", { Parent = Main, Position = UDim2.fromOffset(TabWidth, 40), Size = UDim2.new(1, -TabWidth, 1, -40), BackgroundTransparency = 1 })

    C(UIS.InputBegan, function(i, gp)
        if gp then return end
        local k = cfg.MinimizeKey or Enum.KeyCode.LeftControl
        if i.KeyCode == k then setVisible(not Main.Visible) end
    end)

    ------------------------------------------------------------- Dialog
    function Window:Dialog(d)
        local dim = New("TextButton", { Parent = Main, Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.5, Text = "", AutoButtonColor = false, ZIndex = 50 })
        local box = New("Frame", {
            Parent = dim, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.fromOffset(300, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = Theme.Row,
        }, { Corner(8), Stroke(), Pad(14), List(10) })
        Label({ Parent = box, Text = d.Title or "", Font = Enum.Font.GothamBold, TextSize = 16, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextWrapped = true, LayoutOrder = 1 })
        Label({ Parent = box, Text = d.Content or "", TextSize = 13, TextColor3 = Theme.Sub, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextWrapped = true, LayoutOrder = 2 })
        local row = New("Frame", { Parent = box, Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1, LayoutOrder = 3 }, {
            New("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8) }),
        })
        local btns = d.Buttons or {}
        local n = #btns
        for _, b in ipairs(btns) do
            local btn = New("TextButton", {
                Parent = row, Size = UDim2.new(1 / n, -8 * (n - 1) / n, 1, 0), BackgroundColor3 = Theme.Row2,
                Text = b.Title or "OK", Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = Theme.Text, AutoButtonColor = true,
            }, { Corner(5) })
            btn.MouseButton1Click:Connect(function()
                dim:Destroy()
                if b.Callback then task.spawn(b.Callback) end
            end)
        end
    end

    function Window:SelectTab(i) if tabs[i] then tabs[i].select() end end

    function Window:Destroy()
        Scarlet.Unloaded = true
        for _, c in ipairs(Conns) do pcall(function() c:Disconnect() end) end
        Gui:Destroy()
    end

    ------------------------------------------------------------- Tab
    function Window:AddTab(t)
        local Tab = {}
        local btn = New("TextButton", {
            Parent = Side and TabList, Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = Theme.Row,
            BackgroundTransparency = 1, Text = "", AutoButtonColor = false, LayoutOrder = Ord(),
        }, { Corner(6) })
        local bar = New("Frame", { Parent = btn, Size = UDim2.fromOffset(3, 16), Position = UDim2.new(0, 2, 0.5, -8), BackgroundColor3 = Theme.Accent, Visible = false }, { Corner(2) })
        local off = 14
        if type(t.Icon) == "string" and t.Icon:sub(1, 3) == "rbx" then
            New("ImageLabel", { Parent = btn, BackgroundTransparency = 1, Image = t.Icon, Size = UDim2.fromOffset(18, 18), Position = UDim2.fromOffset(14, 8), ImageColor3 = Theme.Text })
            off = 40
        end
        local lbl = Label({ Parent = btn, Text = t.Title or "Tab", Font = Enum.Font.GothamMedium, TextColor3 = Theme.Sub, Position = UDim2.fromOffset(off, 0), Size = UDim2.new(1, -off, 1, 0) })
        local page = New("ScrollingFrame", {
            Parent = Content, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false,
            ScrollBarThickness = 3, ScrollBarImageColor3 = Theme.Accent, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
        }, { List(6), Pad(12) })

        local rec = {}
        rec.select = function()
            for _, r in ipairs(tabs) do
                r.page.Visible = false
                r.bar.Visible = false
                r.lbl.TextColor3 = Theme.Sub
                Tween(r.btn, { BackgroundTransparency = 1 })
            end
            page.Visible = true
            bar.Visible = true
            lbl.TextColor3 = Theme.Text
            Tween(btn, { BackgroundTransparency = 0 })
        end
        rec.page, rec.bar, rec.lbl, rec.btn = page, bar, lbl, btn
        table.insert(tabs, rec)
        btn.MouseButton1Click:Connect(rec.select)
        if #tabs == 1 then rec.select() end
        Tab.Select = rec.select

        -- tạo 1 hàng chuẩn
        local function MakeRow(c, height, tw)
            local hasDesc = c.Description ~= nil
            local h = height or (hasDesc and 50 or 40)
            local row = New("Frame", { Parent = page, BackgroundColor3 = Theme.Row, Size = UDim2.new(1, 0, 0, h), LayoutOrder = Ord() }, { Corner(6), Stroke() })
            Label({
                Parent = row, Text = c.Title or "", Font = Enum.Font.GothamMedium, TextTruncate = Enum.TextTruncate.AtEnd,
                Position = UDim2.fromOffset(12, hasDesc and 7 or 0), Size = UDim2.new(tw or 0.5, 0, 0, hasDesc and 18 or h),
            })
            if hasDesc then
                Label({
                    Parent = row, Text = c.Description, TextSize = 12, TextColor3 = Theme.Sub, TextTruncate = Enum.TextTruncate.AtEnd,
                    Position = UDim2.fromOffset(12, 26), Size = UDim2.new(tw or 0.5, 0, 0, 16),
                })
            end
            return row
        end

        local function RightBtn(row, w)
            return New("TextButton", {
                Parent = row, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(w, 26),
                BackgroundColor3 = Theme.Row2, Text = "", AutoButtonColor = false,
            }, { Corner(5), Stroke() })
        end

        function Tab:AddSection(title)
            Label({ Parent = page, Text = string.upper(title), Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = Theme.Accent, Size = UDim2.new(1, 0, 0, 22), LayoutOrder = Ord() })
        end

        function Tab:AddParagraph(c)
            local f = New("Frame", { Parent = page, BackgroundColor3 = Theme.Row, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = Ord() }, { Corner(6), Stroke(), Pad(10), List(3) })
            Label({ Parent = f, Text = c.Title or "", Font = Enum.Font.GothamBold, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextWrapped = true, LayoutOrder = 1 })
            Label({ Parent = f, Text = c.Content or "", TextSize = 13, TextColor3 = Theme.Sub, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextWrapped = true, LayoutOrder = 2 })
        end

        function Tab:AddButton(c)
            local row = MakeRow(c)
            local hit = New("TextButton", { Parent = row, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "" })
            Label({ Parent = row, Text = "›", TextSize = 22, TextColor3 = Theme.Sub, Position = UDim2.new(1, -26, 0, 0), Size = UDim2.fromOffset(16, row.Size.Y.Offset) })
            hit.MouseEnter:Connect(function() Tween(row, { BackgroundColor3 = Theme.Row2 }) end)
            hit.MouseLeave:Connect(function() Tween(row, { BackgroundColor3 = Theme.Row }) end)
            hit.MouseButton1Click:Connect(function() if c.Callback then task.spawn(c.Callback) end end)
        end

        function Tab:AddToggle(index, c)
            local row = MakeRow(c)
            local hit = New("TextButton", { Parent = row, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "" })
            local track = New("Frame", { Parent = row, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(38, 20), BackgroundColor3 = Theme.Row2 }, { Corner(10), Stroke() })
            local knob = New("Frame", { Parent = track, Size = UDim2.fromOffset(14, 14), Position = UDim2.fromOffset(3, 3), BackgroundColor3 = Theme.Text }, { Corner(7) })
            local o = { Type = "Toggle", Value = false }
            function o:SetValue(v, silent)
                v = not not v
                if not silent and v == self.Value then return end
                self.Value = v
                Tween(track, { BackgroundColor3 = v and Theme.Accent or Theme.Row2 })
                Tween(knob, { Position = UDim2.fromOffset(v and 21 or 3, 3) })
                if not silent then self:_fire() end
            end
            o:SetValue(c.Default, true)
            hit.MouseButton1Click:Connect(function() o:SetValue(not o.Value) end)
            Finish(o, index, c, function(s) return s.Value end, function(s, d) s:SetValue(d) end)
            return o
        end

        function Tab:AddSlider(index, c)
            local row = MakeRow(c, nil, 0.4)
            local min, max, rnd = c.Min or 0, c.Max or 100, c.Rounding or 0
            local valLbl = Label({ Parent = row, Text = "", TextSize = 13, TextXAlignment = Enum.TextXAlignment.Right, Position = UDim2.new(1, -50, 0, 0), Size = UDim2.new(0, 40, 1, 0) })
            local hit = New("Frame", { Parent = row, BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -60, 0.5, 0), Size = UDim2.fromOffset(110, 22) })
            local bar = New("Frame", { Parent = hit, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.new(1, 0, 0, 6), BackgroundColor3 = Theme.Row2 }, { Corner(3) })
            local fill = New("Frame", { Parent = bar, Size = UDim2.fromScale(0, 1), BackgroundColor3 = Theme.Accent }, { Corner(3) })
            local o = { Type = "Slider" }
            function o:SetValue(v, silent)
                v = Round(math.clamp(tonumber(v) or min, min, max), rnd)
                if not silent and v == self.Value then return end
                self.Value = v
                fill.Size = UDim2.fromScale((v - min) / math.max(max - min, 1e-9), 1)
                valLbl.Text = tostring(v)
                if not silent then self:_fire() end
            end
            o:SetValue(c.Default or min, true)
            Track(hit, function(rx) o:SetValue(min + (max - min) * rx) end)
            Finish(o, index, c, function(s) return s.Value end, function(s, d) s:SetValue(d) end)
            return o
        end

        function Tab:AddDropdown(index, c)
            local row = MakeRow(c)
            local btn = RightBtn(row, 140)
            local txt = Label({ Parent = btn, Size = UDim2.new(1, -26, 1, 0), Position = UDim2.fromOffset(8, 0), TextSize = 13, TextTruncate = Enum.TextTruncate.AtEnd })
            Label({ Parent = btn, Text = "▾", Size = UDim2.fromOffset(16, 26), Position = UDim2.new(1, -18, 0, 0), TextColor3 = Theme.Sub })
            local multi = c.Multi
            local o = { Type = "Dropdown", Values = c.Values or {}, Multi = multi, Value = multi and {} or nil }
            local function display()
                if multi then
                    local t = {}
                    for _, v in ipairs(o.Values) do if o.Value[v] then t[#t + 1] = tostring(v) end end
                    txt.Text = #t > 0 and table.concat(t, ", ") or "None"
                else
                    txt.Text = o.Value ~= nil and tostring(o.Value) or "None"
                end
            end
            function o:SetValue(v, silent)
                if multi then
                    local t = {}
                    if type(v) == "table" then
                        for k, s in pairs(v) do
                            if type(k) == "number" then t[s] = true elseif s then t[k] = true end
                        end
                    end
                    self.Value = t
                else
                    if type(v) == "number" then v = self.Values[v] end
                    self.Value = v
                end
                display()
                if not silent then self:_fire() end
            end
            function o:SetValues(list) self.Values = list display() end
            o:SetValue(c.Default, true)

            btn.MouseButton1Click:Connect(function()
                local h = math.min(#o.Values * 26 + 8, 188)
                local box, catcher = OpenPopup(Gui, btn, btn.AbsoluteSize.X, h)
                local sc = New("ScrollingFrame", {
                    Parent = box, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0,
                    ScrollBarThickness = 3, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
                }, { List(2), Pad(4) })
                local items = {}
                local function refresh()
                    for v, b in pairs(items) do
                        local sel = multi and o.Value[v] or (not multi and o.Value == v)
                        b.BackgroundTransparency = sel and 0.55 or 1
                    end
                end
                for idx, v in ipairs(o.Values) do
                    local b = New("TextButton", { Parent = sc, Size = UDim2.new(1, 0, 0, 24), BackgroundColor3 = Theme.Accent, BackgroundTransparency = 1, Text = "", AutoButtonColor = false, LayoutOrder = idx }, { Corner(4) })
                    Label({ Parent = b, Text = tostring(v), TextSize = 13, Position = UDim2.fromOffset(8, 0), Size = UDim2.new(1, -10, 1, 0) })
                    items[v] = b
                    b.MouseButton1Click:Connect(function()
                        if multi then
                            o.Value[v] = (not o.Value[v]) or nil
                            display() refresh() o:_fire()
                        else
                            o:SetValue(v)
                            catcher:Destroy()
                        end
                    end)
                end
                refresh()
            end)
            Finish(o, index, c,
                function(s)
                    if not multi then return s.Value end
                    local t = {}
                    for k in pairs(s.Value) do t[#t + 1] = k end
                    return t
                end,
                function(s, d) s:SetValue(d) end)
            return o
        end

        function Tab:AddColorpicker(index, c)
            local row = MakeRow(c)
            local sw = RightBtn(row, 44)
            local o = { Type = "Colorpicker", H = 0, S = 0, V = 1 }
            function o:SetHSV(h, s, v, silent)
                self.H, self.S, self.V = h, s, v
                self.Value = Color3.fromHSV(h, s, v)
                sw.BackgroundColor3 = self.Value
                if self._refresh then self._refresh() end
                if not silent then self:_fire() end
            end
            function o:SetValueRGB(col, silent) local h, s, v = col:ToHSV() self:SetHSV(h, s, v, silent) end
            o.SetValue = o.SetValueRGB
            o:SetValueRGB(c.Default or Color3.new(1, 1, 1), true)

            sw.MouseButton1Click:Connect(function()
                local box, catcher = OpenPopup(Gui, sw, 200, 160)
                local white, black = Color3.new(1, 1, 1), Color3.new(0, 0, 0)
                local sv = New("Frame", { Parent = box, Position = UDim2.fromOffset(10, 10), Size = UDim2.fromOffset(180, 110), BorderSizePixel = 0 }, { Corner(4) })
                New("Frame", { Parent = sv, Size = UDim2.fromScale(1, 1), BackgroundColor3 = white, BorderSizePixel = 0 }, { Corner(4), New("UIGradient", { Transparency = NumberSequence.new(0, 1) }) })
                New("Frame", { Parent = sv, Size = UDim2.fromScale(1, 1), BackgroundColor3 = black, BorderSizePixel = 0 }, { Corner(4), New("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1, 0) }) })
                local cur = New("Frame", { Parent = sv, Size = UDim2.fromOffset(10, 10), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1 }, { Corner(5), Stroke(white, 2) })
                local kp = {}
                for i = 0, 6 do table.insert(kp, ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(math.min(i / 6, 1), 1, 1))) end
                local hue = New("Frame", { Parent = box, Position = UDim2.fromOffset(10, 132), Size = UDim2.fromOffset(180, 16), BackgroundColor3 = white, BorderSizePixel = 0 }, { Corner(4), New("UIGradient", { Color = ColorSequence.new(kp) }) })
                local hcur = New("Frame", { Parent = hue, Size = UDim2.fromOffset(4, 20), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = white }, { Corner(2), Stroke(black, 1) })
                local function refresh()
                    sv.BackgroundColor3 = Color3.fromHSV(o.H, 1, 1)
                    cur.Position = UDim2.fromScale(o.S, 1 - o.V)
                    hcur.Position = UDim2.new(o.H, 0, 0.5, 0)
                end
                local off1 = Track(sv, function(rx, ry) o:SetHSV(o.H, rx, 1 - ry) end)
                local off2 = Track(hue, function(rx) o:SetHSV(rx, o.S, o.V) end)
                o._refresh = refresh
                refresh()
                catcher.Destroying:Connect(function() o._refresh = nil off1() off2() end)
            end)
            Finish(o, index, c, function(s) return { s.H, s.S, s.V } end, function(s, d) s:SetHSV(d[1], d[2], d[3]) end)
            return o
        end

        function Tab:AddKeybind(index, c)
            local row = MakeRow(c)
            local btn = RightBtn(row, 120)
            btn.TextSize = 12
            local o = { Type = "Keybind", Value = c.Default or "None", Mode = c.Mode or "Toggle", State = false, _click = {} }
            local txt = Label({ Parent = btn, Size = UDim2.fromScale(1, 1), TextSize = 12, TextXAlignment = Enum.TextXAlignment.Center })
            local function show() txt.Text = o.Value .. " [" .. o.Mode .. "]" end
            local function setState(s)
                if o.State == s then return end
                o.State = s
                for _, f in ipairs(o._click) do task.spawn(f, s) end
            end
            function o:GetState() return self.Mode == "Always" or self.State end
            function o:OnClick(f) table.insert(self._click, f) end
            function o:SetValue(key, mode, silent)
                self.Value = key or self.Value
                self.Mode = mode or self.Mode
                self.State = false
                show()
                if not silent then self:_fire() end
            end
            show()
            if c.Callback then o:OnClick(c.Callback) end

            local listening = false
            btn.MouseButton1Click:Connect(function() listening = true txt.Text = "..." end)
            btn.MouseButton2Click:Connect(function()
                local modes = { "Always", "Toggle", "Hold" }
                local n = table.find(modes, o.Mode) or 1
                o:SetValue(nil, modes[n % 3 + 1])
            end)
            C(UIS.InputBegan, function(i, gp)
                if listening then
                    local key
                    if i.UserInputType == Enum.UserInputType.Keyboard then
                        key = i.KeyCode.Name
                        if key == "Escape" then key = "None" end
                    elseif i.UserInputType == Enum.UserInputType.MouseButton1 then key = "MB1"
                    elseif i.UserInputType == Enum.UserInputType.MouseButton2 then key = "MB2"
                    elseif i.UserInputType == Enum.UserInputType.MouseButton3 then key = "MB3" end
                    if key then listening = false o:SetValue(key) end
                    return
                end
                if gp or o.Value == "None" or o.Mode == "Always" then return end
                if KeyMatch(i, o.Value) then
                    if o.Mode == "Toggle" then setState(not o.State) else setState(true) end
                end
            end)
            C(UIS.InputEnded, function(i)
                if o.Mode == "Hold" and KeyMatch(i, o.Value) then setState(false) end
            end)
            Finish(o, index, { Callback = c.ChangedCallback },
                function(s) return { s.Value, s.Mode } end,
                function(s, d) s:SetValue(d[1], d[2]) end)
            return o
        end

        function Tab:AddInput(index, c)
            local row = MakeRow(c)
            local box = New("TextBox", {
                Parent = row, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(140, 26),
                BackgroundColor3 = Theme.Row2, Text = c.Default or "", PlaceholderText = c.Placeholder or "", PlaceholderColor3 = Theme.Sub,
                TextColor3 = Theme.Text, Font = Enum.Font.Gotham, TextSize = 13, ClearTextOnFocus = false,
            }, { Corner(5), Stroke() })
            local o = { Type = "Input", Value = c.Default or "" }
            local muted = false
            function o:SetValue(v, silent)
                v = tostring(v)
                muted = true box.Text = v muted = false
                self.Value = v
                if not silent then self:_fire() end
            end
            box:GetPropertyChangedSignal("Text"):Connect(function()
                if muted then return end
                if c.Numeric then
                    local f = (box.Text:gsub("[^%d%.%-]", ""))
                    if f ~= box.Text then box.Text = f return end
                end
                if not c.Finished then o.Value = box.Text o:_fire() end
            end)
            box.FocusLost:Connect(function()
                if c.Finished then o.Value = box.Text o:_fire() end
            end)
            Finish(o, index, c, function(s) return s.Value end, function(s, d) s:SetValue(d) end)
            return o
        end

        return Tab
    end

    return Window
end

return Scarlet
