local Players = game:GetService("Players")
local player = Players.LocalPlayer
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local camera = workspace.CurrentCamera
local char = player.Character or player.CharacterAdded:Wait()
local hrp = char:WaitForChild("HumanoidRootPart")
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
local Window = Rayfield:CreateWindow({
   Name = "SalorPiece", 
   LoadingTitle = "",
   LoadingSubtitle = "",
   ConfigurationSaving = {Enabled=true, FolderName="SalorPieceConfig", FileName="Settings"}
})
local MainTab = Window:CreateTab("Main", 4483362458)

getgenv().AutoFarm = false
getgenv().AttackRate = 0.01
getgenv().TPDistance = 11
getgenv().AutoEquipWeapon = false
getgenv().SelectedWeapon = ""

local AttackRemote = ReplicatedStorage:WaitForChild("CombatSystem"):WaitForChild("Remotes"):WaitForChild("RequestHit")
local QuestRemote = ReplicatedStorage:WaitForChild("RemoteEvents"):WaitForChild("QuestAccept")
local QuestAbandonRemote = ReplicatedStorage:WaitForChild("RemoteEvents"):WaitForChild("QuestAbandon")

local PlayerGui = player:WaitForChild("PlayerGui")
local LevelValue = player:WaitForChild("Data"):WaitForChild("Level")
local Character = player.Character or player.CharacterAdded:Wait()
local HRP = Character:WaitForChild("HumanoidRootPart")
local CurrentTarget = nil
local IsAlive = true
local CurrentQuest = nil

MainTab:CreateToggle({
    Name = "Auto Farm",
    CurrentValue = getgenv().AutoFarm,
    Flag = "AutoFarmToggle",
    Callback = function(value)
        getgenv().AutoFarm = value
    end
})

MainTab:CreateToggle({
    Name = "Auto Equip Weapon",
    CurrentValue = getgenv().AutoEquipWeapon,
    Flag = "AutoEquipToggle",
    Callback = function(value)
        getgenv().AutoEquipWeapon = value
    end
})

local function GetWeaponsInBackpack()
    local Backpack = player:FindFirstChild("Backpack")
    local weapons = {}
    if Backpack then
        for _, tool in pairs(Backpack:GetChildren()) do
            if tool:IsA("Tool") then
                table.insert(weapons, tool.Name)
            end
        end
    end
    return weapons
end

MainTab:CreateDropdown({
    Name = "Select Weapon",
    Options = GetWeaponsInBackpack(),
    CurrentOption = getgenv().SelectedWeapon,
    Flag = "WeaponDropdown",
    Callback = function(value)
        getgenv().SelectedWeapon = value
    end
})

MainTab:CreateSlider({
    Name = "TP Distance",
    Range = {1,50},
    Increment = 1,
    Suffix = " studs",
    CurrentValue = getgenv().TPDistance,
    Flag = "TPDistanceSlider",
    Callback = function(value)
        getgenv().TPDistance = value
    end
})

local function UpdatePlayerStatus()
    Character = player.Character
    if not Character then
        IsAlive = false
        return
    end
    local Humanoid = Character:FindFirstChild("Humanoid")
    if Humanoid and Humanoid.Health > 0 then
        IsAlive = true
        HRP = Character:WaitForChild("HumanoidRootPart")
    else
        IsAlive = false
    end
end

local function AutoEquipWeaponFunc()
    if not getgenv().AutoEquipWeapon then return end
    if not Character then return end
    local Humanoid = Character:FindFirstChild("Humanoid")
    if not Humanoid then return end
    local Backpack = player:FindFirstChild("Backpack")
    if not Backpack then return end
    local Tool = Backpack:FindFirstChild(getgenv().SelectedWeapon)
    if Tool then
        Humanoid:EquipTool(Tool)
    end
end

RunService.Heartbeat:Connect(function()
    UpdatePlayerStatus()
    AutoEquipWeaponFunc()
    if getgenv().AutoFarm and IsAlive and CurrentTarget and CurrentTarget.Parent then
        local hrp = CurrentTarget:FindFirstChild("HumanoidRootPart")
        if hrp then
            HRP.CFrame = CFrame.new(hrp.Position + hrp.CFrame.LookVector * -getgenv().TPDistance, hrp.Position)
        end
    end
end)

task.spawn(function()
    while true do
        if getgenv().AutoFarm and IsAlive and CurrentTarget and CurrentTarget.Parent then
            pcall(function()
                AttackRemote:FireServer(CurrentTarget)
            end)
        end
        task.wait(getgenv().AttackRate)
    end
end)

task.spawn(function()
    while true do
        local dropdown = Rayfield.Flags.WeaponDropdown
        if dropdown then
            local weapons = GetWeaponsInBackpack()
            dropdown:Refresh(weapons)
        end
        task.wait(5)
    end
end)
